generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  category    String
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
